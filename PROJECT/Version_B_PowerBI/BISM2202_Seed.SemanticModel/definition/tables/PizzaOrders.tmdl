	partition PizzaOrders = m
		mode: import
		source =
				let
				    源 = Excel.Workbook(File.Contents("C:\BISM2202\INPUTS\Assignment1_BISM2202_pizza_sell_data.xlsx"), null, true),
				    Sheet1_Sheet = 源{[Item="Sheet1",Kind="Sheet"]}[Data],
				    提升的标题 = Table.PromoteHeaders(Sheet1_Sheet, [PromoteAllScalars=true]),
				    更改的类型 = Table.TransformColumnTypes(提升的标题,{{"Order ID", type text}, {"Restaurant Name", type text}, {"Location", type text}, {"Order Time", type datetime}, {"Delivery Time", type datetime}, {"Delivery Duration (min)", Int64.Type}, {"Pizza Size", type text}, {"Pizza Type", type text}, {"Toppings Count", Int64.Type}, {"Distance (km)", type number}, {"Traffic Level", type text}, {"Payment Method", type text}, {"Is Peak Hour", type logical}, {"Is Weekend", type logical}, {"Delivery Efficiency (min/km)", type number}, {"Topping Density", type number}, {"Order Month", type text}, {"Payment Category", type text}, {"Estimated Duration (min)", type number}, {"Delay (min)", type number}, {"Is Delayed", type logical}, {"Pizza Complexity", Int64.Type}, {"Traffic Impact", Int64.Type}, {"Order Hour", Int64.Type}, {"Restaurant Avg Time", type number}}),
