	column 'Restaurant Avg Time'
		dataType: double
		lineageTag: 6f14b459-ad85-4883-adcb-0cc3b99b5b97
		summarizeBy: sum
		sourceColumn: Restaurant Avg Time

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Order Count' = DISTINCTCOUNT(PizzaOrders[Order ID])
		formatString: #,0
		displayFolder: BISM2202 Measures

	measure 'Avg Delivery Duration' = AVERAGE(PizzaOrders[Delivery Duration (min)])
		formatString: 0.00
		displayFolder: BISM2202 Measures

	measure 'Avg Toppings Count' = AVERAGE(PizzaOrders[Toppings Count])
		formatString: 0.00
		displayFolder: BISM2202 Measures

	measure 'Avg Delay' = AVERAGE(PizzaOrders[Delay (min)])
		formatString: 0.00
		displayFolder: BISM2202 Measures

	measure 'Avg Topping Density' = AVERAGE(PizzaOrders[Topping Density])
		formatString: 0.000
		displayFolder: BISM2202 Measures

	measure 'Delivery Duration Color' = VAR CurrentValue = [Avg Delivery Duration] VAR MinValue = MINX(ALL(PizzaOrders[Restaurant Name]), CALCULATE([Avg Delivery Duration])) VAR MaxValue = MAXX(ALL(PizzaOrders[Restaurant Name]), CALCULATE([Avg Delivery Duration])) RETURN SWITCH(TRUE(), CurrentValue = MinValue, "#C6EFCE", CurrentValue = MaxValue, "#FFC7CE", "#FFF2CC")
		displayFolder: BISM2202 Helpers

	measure 'Delay Color' = VAR CurrentValue = [Avg Delay] VAR MinValue = MINX(ALL(PizzaOrders[Restaurant Name]), CALCULATE([Avg Delay])) VAR MaxValue = MAXX(ALL(PizzaOrders[Restaurant Name]), CALCULATE([Avg Delay])) RETURN SWITCH(TRUE(), CurrentValue = MinValue, "#C6EFCE", CurrentValue = MaxValue, "#FFC7CE", "#FFF2CC")
		displayFolder: BISM2202 Helpers

	column 'Weekend Label' = IF(PizzaOrders[Is Weekend] = TRUE(), "Weekend", "Weekday")
		dataType: string
		summarizeBy: none

	column 'Peak Hour Label' = IF(PizzaOrders[Is Peak Hour] = TRUE(), "Peak Hour", "Non-Peak Hour")
		dataType: string
		summarizeBy: none

	column 'Order Month Sorted' = FORMAT(PizzaOrders[Order Time], "MM - MMMM")
		dataType: string
		summarizeBy: none

	column __OrderOne = 1
		dataType: int64
		formatString: 0
		summarizeBy: sum
		isHidden

	column __LocationAvgDeliveryContribution = DIVIDE(CALCULATE(AVERAGE(PizzaOrders[Delivery Duration (min)]), ALLEXCEPT(PizzaOrders, PizzaOrders[Location])), CALCULATE(DISTINCTCOUNT(PizzaOrders[Order ID]), ALLEXCEPT(PizzaOrders, PizzaOrders[Location])))
		dataType: double
		summarizeBy: sum
		isHidden

	column __RestaurantAvgDelayContribution = DIVIDE(CALCULATE(AVERAGE(PizzaOrders[Delay (min)]), ALLEXCEPT(PizzaOrders, PizzaOrders[Restaurant Name])), CALCULATE(DISTINCTCOUNT(PizzaOrders[Order ID]), ALLEXCEPT(PizzaOrders, PizzaOrders[Restaurant Name])))
		dataType: double
		summarizeBy: sum
		isHidden

	column __PizzaTypeAvgDeliveryContribution = DIVIDE(CALCULATE(AVERAGE(PizzaOrders[Delivery Duration (min)]), ALLEXCEPT(PizzaOrders, PizzaOrders[Pizza Type])), CALCULATE(DISTINCTCOUNT(PizzaOrders[Order ID]), ALLEXCEPT(PizzaOrders, PizzaOrders[Pizza Type])))
		dataType: double
		summarizeBy: sum
		isHidden

	partition PizzaOrders = m
		mode: import
		source =
				let
				    源 = Excel.Workbook(File.Contents("C:\BISM2202\INPUTS\Assignment1_BISM2202_pizza_sell_data.xlsx"), null, true),
				    Sheet1_Sheet = 源{[Item="Sheet1",Kind="Sheet"]}[Data],
				    提升的标题 = Table.PromoteHeaders(Sheet1_Sheet, [PromoteAllScalars=true]),
				    更改的类型 = Table.TransformColumnTypes(提升的标题,{{"Order ID", type text}, {"Restaurant Name", type text}, {"Location", type text}, {"Order Time", type datetime}, {"Delivery Time", type datetime}, {"Delivery Duration (min)", Int64.Type}, {"Pizza Size", type text}, {"Pizza Type", type text}, {"Toppings Count", Int64.Type}, {"Distance (km)", type number}, {"Traffic Level", type text}, {"Payment Method", type text}, {"Is Peak Hour", type logical}, {"Is Weekend", type logical}, {"Delivery Efficiency (min/km)", type number}, {"Topping Density", type number}, {"Order Month", type text}, {"Payment Category", type text}, {"Estimated Duration (min)", type number}, {"Delay (min)", type number}, {"Is Delayed", type logical}, {"Pizza Complexity", Int64.Type}, {"Traffic Impact", Int64.Type}, {"Order Hour", Int64.Type}, {"Restaurant Avg Time", type number}}),
				    替换的值 = Table.ReplaceValue(更改的类型,"Marco’s Pizza","Marco's Pizza",Replacer.ReplaceText,{"Restaurant Name"})
				in
				    替换的值

	annotation PBI_NavigationStepName = 导航

	annotation PBI_ResultType = Table

